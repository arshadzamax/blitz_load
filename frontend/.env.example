# Frontend environment variables for Blitz Load
# Copy this file to .env.development, .env.production, or .env.local as needed.

# Base path for backend API calls. Keep /api when the frontend is proxied to the server.
VITE_API_BASE=/api

# Local dev backend target for the Vite proxy server.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional frontend dev port.
VITE_DEV_PORT=5173
